# Texas Parse Cloud — example environment
# Copy to .env and change every secret before you deploy:  cp .env.example .env
#
# NOTE: Parse Server only reads the PARSE_SERVER_* names used by
# docker-compose.yml. The short names below (APP_ID / MASTER_KEY) are read
# by docker-compose and passed through to the server under the correct
# PARSE_SERVER_* names. If you run the server WITHOUT Docker, export the
# PARSE_SERVER_* names directly — see README Quick Start.

# Your application ID (any string; clients send it as X-Parse-Application-Id)
APP_ID=TEXAS

# Master key — the keys to the kingdom. Use a long random secret.
# Generate one with:  openssl rand -hex 32
MASTER_KEY=change-me-to-a-long-random-secret

# Parse Dashboard login (only used with: docker compose --profile dashboard up -d)
DASHBOARD_USER=texasadmin
DASHBOARD_PASSWORD=change-me-too

# --- Running without Docker? Use these exact names: -------------------------
# PARSE_SERVER_APPLICATION_ID=TEXAS
# PARSE_SERVER_MASTER_KEY=change-me-to-a-long-random-secret
# PARSE_SERVER_DATABASE_URI=mongodb://localhost:27017/dev
# PORT=1337
